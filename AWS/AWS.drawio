  <diagram name="2 - Roteiro e análises" id="Po7M7D93U4KlvfjHJnhn">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=28;fontStyle=1;fontColor=#102A43;" value="Roteiro de implementação e plano de análises" vertex="1">
          <mxGeometry height="42" width="1600" x="50" y="25" as="geometry" />
        </mxCell>
        <mxCell id="p2-subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=15;fontColor=#627D98;" value="Siga a coluna esquerda na ordem. Cada etapa só termina quando o critério de aceite estiver verde. A coluna direita transforma as perguntas do PDF em tabelas Gold e gráficos do notebook." vertex="1">
          <mxGeometry height="32" width="1780" x="50" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-left-header" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#9FB3C8;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#243B53;" value="&lt;b&gt;ORDEM DE EXECUÇÃO&lt;/b&gt;" vertex="1">
          <mxGeometry height="45" width="850" x="50" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-right-header" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Arial;fontSize=16;fontColor=#3C1E70;" value="&lt;b&gt;PLANO DE ANÁLISES NO JUPYTER / GOLD&lt;/b&gt;" vertex="1">
          <mxGeometry height="45" width="900" x="960" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-step0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334E68;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#102A43;shadow=1;" value="&lt;b&gt;0. Preparar entradas e parâmetros&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334E68&quot;&gt;3 CSVs oficiais + crosswalk | paths por ambiente | ano_pesquisa | run_id&lt;br&gt;&lt;b&gt;Aceite:&lt;/b&gt; arquivos abrem, headers conferem e total bruto = 14.005.&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="850" x="50" y="185" as="geometry" />
        </mxCell>
        <mxCell id="p2-step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#FF9900;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#6B3D00;shadow=1;" value="&lt;b&gt;1. Subir Landing e executar Glue Job 01&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334E68&quot;&gt;preservar CSVs | gerar manifesto/checksum | perfilar schema/nulos | gravar Bronze Parquet&lt;br&gt;&lt;b&gt;Aceite:&lt;/b&gt; Bronze = 14.005; schemas de origem 399 / 403 / 388; arquivos rastreáveis.&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="850" x="50" y="290" as="geometry" />
        </mxCell>
        <mxCell id="p2-step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F0;strokeColor=#2E7D32;strokeWidth=3;fontFamily=Arial;fontSize=13;fontColor=#173A1A;shadow=1;" value="&lt;b&gt;2. Executar Glue Job 02 e materializar Silver&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334E68&quot;&gt;crosswalk | nomes canônicos | trim/casts/flags | deduplicação | unionByName&lt;br&gt;&lt;b&gt;Aceite:&lt;/b&gt; 14.002 x 488; 0 duplicatas; 2023=5.293, 2024=5.215, 2025=3.494.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="850" x="50" y="400" as="geometry" />
        </mxCell>
        <mxCell id="p2-step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#3C1E70;shadow=1;" value="&lt;b&gt;3. Catalogar e validar com Athena&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334E68&quot;&gt;criar database/tabelas/partições | executar SQL de contagem, nulos e reconciliação&lt;br&gt;&lt;b&gt;Aceite:&lt;/b&gt; Bronze, Silver e partições consultáveis; resultados SQL salvos como evidência.&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="850" x="50" y="515" as="geometry" />
        </mxCell>
        <mxCell id="p2-step4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E57C2;strokeWidth=3;fontFamily=Arial;fontSize=13;fontColor=#3C1E70;shadow=1;" value="&lt;b&gt;4. Construir notebook Gold + gráficos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334E68&quot;&gt;uma seção por pergunta de negócio | células: leitura, regra, tabela Gold, QA, gráfico e insight&lt;br&gt;&lt;b&gt;Aceite:&lt;/b&gt; notebook executa do início ao fim e exporta Gold + PNG/SVG + tabelas CSV.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="850" x="50" y="625" as="geometry" />
        </mxCell>
        <mxCell id="p2-step5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#1565C0;strokeWidth=3;fontFamily=Arial;fontSize=13;fontColor=#0B3B68;shadow=1;" value="&lt;b&gt;5. Montar e revisar o material executivo&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334E68&quot;&gt;problema -&amp;gt; método -&amp;gt; evidência -&amp;gt; insight -&amp;gt; recomendação | incluir arquitetura e limitações&lt;br&gt;&lt;b&gt;Aceite:&lt;/b&gt; PowerPoint/PDF conta uma narrativa, responde às perguntas e cita período/fonte.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="850" x="50" y="740" as="geometry" />
        </mxCell>
        <mxCell id="p2-analysis1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#3C1E70;shadow=1;" value="&lt;b&gt;A. Estrutura do mercado e perfis valorizados&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E3A8A&quot;&gt;Gold: gold_perfil + gold_remuneracao&lt;br&gt;Dimensões: ano, função, senioridade e faixa salarial&lt;br&gt;Gráficos: barras/linha de evolução e faixas de remuneração&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="440" x="960" y="185" as="geometry" />
        </mxCell>
        <mxCell id="p2-analysis2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#3C1E70;shadow=1;" value="&lt;b&gt;B. Diversidade de gênero&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E3A8A&quot;&gt;Gold: gold_diversidade&lt;br&gt;Dimensões: ano, gênero, função e senioridade&lt;br&gt;Gráficos: barras 100% empilhadas + evolução temporal&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="440" x="1420" y="185" as="geometry" />
        </mxCell>
        <mxCell id="p2-analysis3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#3C1E70;shadow=1;" value="&lt;b&gt;C. Tecnologias mais adotadas&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E3A8A&quot;&gt;Gold: gold_tecnologias_ia&lt;br&gt;Tratar respostas múltiplas como flags e usar respondentes válidos&lt;br&gt;Gráficos: Top N por ano + heatmap de adoção&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="440" x="960" y="340" as="geometry" />
        </mxCell>
        <mxCell id="p2-analysis4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#3C1E70;shadow=1;" value="&lt;b&gt;D. Adoção e impacto de Inteligência Artificial&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E3A8A&quot;&gt;Gold: gold_tecnologias_ia&lt;br&gt;Dimensões: ano, uso de IA, função e impacto percebido&lt;br&gt;Gráficos: barras empilhadas + linha de evolução&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="440" x="1420" y="340" as="geometry" />
        </mxCell>
        <mxCell id="p2-analysis5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#3C1E70;shadow=1;" value="&lt;b&gt;E. Região, senioridade e modelo de trabalho&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E3A8A&quot;&gt;Gold: gold_regiao_trabalho&lt;br&gt;Dimensões: ano, região, senioridade, remoto/híbrido/presencial&lt;br&gt;Gráficos: heatmap + barras agrupadas&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="440" x="960" y="495" as="geometry" />
        </mxCell>
        <mxCell id="p2-analysis6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7E57C2;strokeWidth=2;fontFamily=Arial;fontSize=12;fontColor=#3C1E70;shadow=1;" value="&lt;b&gt;F. Oportunidades e desafios estratégicos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E3A8A&quot;&gt;Gold: gold_kpis_executivos&lt;br&gt;Cruzar lacunas de competências, adoção, remuneração e diversidade&lt;br&gt;Saída: quadro evidência -&amp;gt; implicação -&amp;gt; recomendação&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="440" x="1420" y="495" as="geometry" />
        </mxCell>
        <mxCell id="p2-rule" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#F9A825;strokeWidth=3;fontFamily=Arial;fontSize=13;fontColor=#6B3D00;shadow=1;" value="&lt;b&gt;Regra para todos os indicadores&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7A4A00&quot;&gt;Não usar 14.002 como denominador automático. Para cada pergunta e ano, o denominador é a quantidade de respondentes válidos daquela variável. Em questões de múltipla escolha, uma pessoa pode contribuir para mais de uma categoria. Mostrar N válido, filtros e período no gráfico.&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="900" x="960" y="655" as="geometry" />
        </mxCell>
        <mxCell id="p2-done" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#334E68;strokeWidth=3;fontFamily=Arial;fontSize=13;fontColor=#102A43;shadow=1;" value="&lt;b&gt;DEFINITION OF DONE - ENTREGA FINAL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#334E68&quot;&gt;[ ] diagrama .drawio + imagem no material &amp;nbsp; [ ] notebooks/scripts organizados e executáveis &amp;nbsp; [ ] Bronze/Silver/Gold no S3 e catalogados &amp;nbsp; [ ] QA de contagens e percentuais &amp;nbsp; [ ] gráficos exportados em alta resolução &amp;nbsp; [ ] PowerPoint/PDF com insights e recomendações &amp;nbsp; [ ] fontes, período, limitações e responsabilidades do time documentados&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="1810" x="50" y="875" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-0-1" edge="1" parent="1" source="p2-step0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334E68;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="p2-step1">
          <mxGeometry relative="1" as="geometry" />
